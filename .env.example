MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id
MICROSOFT_REDIRECT_URI=https://yourdomain.com/api/auth/callback/microsoft
DATABASE_URL=postgresql://postgres:postgres@db:5432/sprintboard

# Hotjar (session recordings + heatmaps). Numeric Site ID from the Hotjar
# dashboard. Leave BLANK to disable: no snippet is injected and no request to
# static.hotjar.com is made. Blank is the intended default so local dev never
# records into the same Hotjar site as real users — set it only in production.
HOTJAR_SITE_ID=
