{
  "name": "sprintboard",
  "version": "1.0.0",
  "description": "Sprint & Kanban Board with SLA Tracking — PostgreSQL backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node tests/run.js",
    "test:shuffle": "node tests/run.js --shuffle",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "setup-db": "node db/setup.js",
    "seed-qa": "node db/seed-qa-data.js",
    "test-scenarios": "node scripts/test-scenarios.js",
    "test-hotjar": "node scripts/test-hotjar.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "dompurify": "^3.4.14",
    "nodemon": "^3.0.2",
    "playwright": "^1.62.1"
  }
}
